      "targets": [
        {
          "dataset": "glue-dispenser-db",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bfc3wenp44lxcc"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH starts AS (\n  SELECT DISTINCT timestamp AS start_time\n  FROM process_metrics\n  WHERE station_name = '${station_name}'\n    AND metric_name IN (\n        'shuttle_pre_scan_time',\n        'buffer_holding_time',\n        'dispenser_entry_unclamp_time',\n        'inspection_lifter_rising_time'\n    )\n),\n\nends AS (\n  SELECT DISTINCT timestamp AS end_time\n  FROM process_metrics\n  WHERE station_name = '${station_name}'\n    AND metric_name IN (\n        'shuttle_stopper_rising_time',\n        'buffer_pallet_release_time',\n        'dispenser_stopper_rasing',\n        'inspection_pallet_releasing_time'\n    )\n),\n\ncycle_pair AS (\n  SELECT\n    s.start_time,\n    MIN(e.end_time) AS end_time\n  FROM starts s\n  JOIN ends e\n    ON e.end_time > s.start_time\n  WHERE s.start_time BETWEEN\n        '${anomaly_time}'::timestamptz - INTERVAL '10 seconds'\n    AND '${anomaly_time}'::timestamptz + INTERVAL '10 seconds'\n  GROUP BY s.start_time\n),\n\nmetric_data AS (\n  SELECT DISTINCT ON (p.metric_name, p.timestamp)\n         p.metric_name,\n         p.value,\n         p.unit,\n         p.timestamp\n  FROM cycle_pair cp\n  JOIN process_metrics p\n    ON p.timestamp >= cp.start_time\n   AND p.timestamp <= cp.end_time\n   AND p.station_name = '${station_name}'\n  ORDER BY p.metric_name, p.timestamp\n)\n\nSELECT *\nFROM metric_data\nORDER BY timestamp;",
          "refId": "A",
          "sql": {
            "columns": [
