          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (p.metric_name)\n  p.metric_name,\n  p.value,\n  p.unit,\n  p.timestamp\nFROM process_metrics p\nWHERE p.station_name = '${station_name}'\n  AND p.timestamp BETWEEN\n      to_timestamp(${anomaly_time}::bigint / 1000.0) - INTERVAL '30 seconds'\n  AND to_timestamp(${anomaly_time}::bigint / 1000.0) + INTERVAL '30 seconds'\nORDER BY p.metric_name, ABS(EXTRACT(EPOCH FROM (p.timestamp - to_timestamp(${anomaly_time}::bigint / 1000.0))));",
