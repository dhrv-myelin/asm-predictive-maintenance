          "rawSql": "SELECT timestamp AS time,\n  STDDEV_SAMP(value) OVER (ORDER BY timestamp RANGE BETWEEN INTERVAL '${rolling_window}' PRECEDING AND CURRENT ROW) AS rolling_std\nFROM process_metrics\nWHERE metric_name = 'cycle_time' AND station_name = 'system' AND $__timeFilter(timestamp)\nORDER BY timestamp;",
