          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\n  predicted_timestamp AS time,\n  LAG(predicted_value) OVER (\n      ORDER BY predicted_timestamp, id\n  ) AS predicted_cycle_time\nFROM model_predictions\nWHERE\n  station_name = 'system'\n  AND metric_name = 'cycle_time'\n  AND model_name = 'mamba'\n  AND $__timeFilter(predicted_timestamp)\nORDER BY predicted_timestamp;",
          "refId": "G",
          "sql": {
            "columns": [
              {
                "parameters": [],
