        {
          "dataset": "glue-dispenser-db",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bfc3wenp44lxcc"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "CREATE OR REPLACE VIEW system_cycle_time_nelson_view AS\n\nWITH ordered AS (\n\n    SELECT\n\n        pm.timestamp AS time, pm.value,\n\n        bm.mean, bm.std_dev AS std,\n\n        bm.mean + (0.75 * bm.std_dev) AS upper_2_5sigma,\n\n        bm.mean - (0.75 * bm.std_dev) AS lower_2_5sigma,\n\n        ROW_NUMBER() OVER (ORDER BY pm.timestamp) AS rn\n\n    FROM public.process_metrics pm\n\n    JOIN public.baseline_metrics bm\n\n      ON bm.station_name = pm.station_name AND bm.metric_name = pm.metric_name\n\n    WHERE pm.station_name = 'system'\n\n      AND pm.metric_name = 'cycle_time'\n\n),\n\nrules AS (\n\n    SELECT *,\n\n        -- Rule 1: single point beyond 3σ\n\n        (ABS(value - mean) > 3 * std) AS rule1_trigger,\n \n        -- Rule 2: 9 consecutive same side\n\n        CASE WHEN\n\n            (value > mean AND LAG(value,1) OVER w > mean AND LAG(value,2) OVER w > mean\n\n             AND LAG(value,3) OVER w > mean AND LAG(value,4) OVER w > mean\n\n             AND LAG(value,5) OVER w > mean AND LAG(value,6) OVER w > mean\n\n             AND LAG(value,7) OVER w > mean AND LAG(value,8) OVER w > mean)\n\n        OR  (value < mean AND LAG(value,1) OVER w < mean AND LAG(value,2) OVER w < mean\n\n             AND LAG(value,3) OVER w < mean AND LAG(value,4) OVER w < mean\n\n             AND LAG(value,5) OVER w < mean AND LAG(value,6) OVER w < mean\n\n             AND LAG(value,7) OVER w < mean AND LAG(value,8) OVER w < mean)\n\n        THEN TRUE ELSE FALSE END AS rule2_trigger,\n \n        -- Rule 3: 6 consecutive trending\n\n        CASE WHEN\n\n            (value > LAG(value,1) OVER w AND LAG(value,1) OVER w > LAG(value,2) OVER w\n\n             AND LAG(value,2) OVER w > LAG(value,3) OVER w AND LAG(value,3) OVER w > LAG(value,4) OVER w\n\n             AND LAG(value,4) OVER w > LAG(value,5) OVER w)\n\n        OR  (value < LAG(value,1) OVER w AND LAG(value,1) OVER w < LAG(value,2) OVER w\n\n             AND LAG(value,2) OVER w < LAG(value,3) OVER w AND LAG(value,3) OVER w < LAG(value,4) OVER w\n\n             AND LAG(value,4) OVER w < LAG(value,5) OVER w)\n\n        THEN TRUE ELSE FALSE END AS rule3_trigger,\n \n        -- Rule 4: DISABLED\n\n        FALSE AS rule4_trigger,\n \n        -- Rule 5: 2 of 3 beyond 2σ same side\n\n        CASE WHEN\n\n            (CASE WHEN value > mean + 2*std THEN 1 ELSE 0 END +\n\n             CASE WHEN LAG(value,1) OVER w > mean + 2*std THEN 1 ELSE 0 END +\n\n             CASE WHEN LAG(value,2) OVER w > mean + 2*std THEN 1 ELSE 0 END) >= 2\n\n        OR  (CASE WHEN value < mean - 2*std THEN 1 ELSE 0 END +\n\n             CASE WHEN LAG(value,1) OVER w < mean - 2*std THEN 1 ELSE 0 END +\n\n             CASE WHEN LAG(value,2) OVER w < mean - 2*std THEN 1 ELSE 0 END) >= 2\n\n        THEN TRUE ELSE FALSE END AS rule5_trigger,\n \n        -- Rule 6: 4 of 5 beyond 1σ same side\n\n        CASE WHEN\n\n            (CASE WHEN value > mean + std THEN 1 ELSE 0 END +\n\n             CASE WHEN LAG(value,1) OVER w > mean + std THEN 1 ELSE 0 END +\n\n             CASE WHEN LAG(value,2) OVER w > mean + std THEN 1 ELSE 0 END +\n\n             CASE WHEN LAG(value,3) OVER w > mean + std THEN 1 ELSE 0 END +\n\n             CASE WHEN LAG(value,4) OVER w > mean + std THEN 1 ELSE 0 END) >= 4\n\n        OR  (CASE WHEN value < mean - std THEN 1 ELSE 0 END +\n\n             CASE WHEN LAG(value,1) OVER w < mean - std THEN 1 ELSE 0 END +\n\n             CASE WHEN LAG(value,2) OVER w < mean - std THEN 1 ELSE 0 END +\n\n             CASE WHEN LAG(value,3) OVER w < mean - std THEN 1 ELSE 0 END +\n\n             CASE WHEN LAG(value,4) OVER w < mean - std THEN 1 ELSE 0 END) >= 4\n\n        THEN TRUE ELSE FALSE END AS rule6_trigger,\n \n        -- Rule 7: DISABLED\n\n        FALSE AS rule7_trigger,\n \n        -- Rule 8: 8 consecutive beyond 1σ either side\n\n        CASE WHEN\n\n            ABS(value - mean) > std AND ABS(LAG(value,1) OVER w - mean) > std AND\n\n            ABS(LAG(value,2) OVER w - mean) > std AND ABS(LAG(value,3) OVER w - mean) > std AND\n\n            ABS(LAG(value,4) OVER w - mean) > std AND ABS(LAG(value,5) OVER w - mean) > std AND\n\n            ABS(LAG(value,6) OVER w - mean) > std AND ABS(LAG(value,7) OVER w - mean) > std\n\n        THEN TRUE ELSE FALSE END AS rule8_trigger\n\n    FROM ordered WINDOW w AS (ORDER BY rn)\n\n),\n\nbackfilled AS (\n\n    SELECT *,\n\n        rule1_trigger AS rule1,\n\n        CASE WHEN MAX(CASE WHEN rule2_trigger THEN 1 ELSE 0 END) OVER (ORDER BY rn ROWS BETWEEN CURRENT ROW AND 8 FOLLOWING) = 1 THEN TRUE ELSE FALSE END AS rule2,\n\n        CASE WHEN MAX(CASE WHEN rule3_trigger THEN 1 ELSE 0 END) OVER (ORDER BY rn ROWS BETWEEN CURRENT ROW AND 5 FOLLOWING) = 1 THEN TRUE ELSE FALSE END AS rule3,\n\n        FALSE AS rule4,\n\n        CASE WHEN MAX(CASE WHEN rule5_trigger THEN 1 ELSE 0 END) OVER (ORDER BY rn ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) = 1 THEN TRUE ELSE FALSE END AS rule5,\n\n        CASE WHEN MAX(CASE WHEN rule6_trigger THEN 1 ELSE 0 END) OVER (ORDER BY rn ROWS BETWEEN CURRENT ROW AND 4 FOLLOWING) = 1 THEN TRUE ELSE FALSE END AS rule6,\n\n        FALSE AS rule7,\n\n        CASE WHEN MAX(CASE WHEN rule8_trigger THEN 1 ELSE 0 END) OVER (ORDER BY rn ROWS BETWEEN CURRENT ROW AND 7 FOLLOWING) = 1 THEN TRUE ELSE FALSE END AS rule8\n\n    FROM rules\n\n),\n\nfinal AS (\n\n    SELECT *, (rule1 OR rule2 OR rule3 OR rule4 OR rule5 OR rule6 OR rule7 OR rule8) AS any_violation FROM backfilled\n\n)\n\nSELECT time, value, mean, upper_2_5sigma, lower_2_5sigma,\n\n    CASE WHEN any_violation THEN value ELSE NULL END AS anomaly_point,\n\n    CONCAT_WS(' | ',\n\n        CASE WHEN rule1 THEN 'Extreme Outlier Detected' END,\n\n        CASE WHEN rule2 THEN 'Process Shift Detected' END,\n\n        CASE WHEN rule3 THEN 'Process Drift Detected' END,\n\n        CASE WHEN rule4 THEN 'Unstable Oscillation Detected' END,\n\n        CASE WHEN rule5 THEN 'Early Warning: Shift Developing' END,\n\n        CASE WHEN rule6 THEN 'Gradual Drift Detected' END,\n\n        CASE WHEN rule7 THEN 'Abnormal Stability Detected' END,\n\n        CASE WHEN rule8 THEN 'High Variability Detected' END\n\n    ) AS rule_description\n\nFROM final ORDER BY time;\n ",
          "refId": "H",
