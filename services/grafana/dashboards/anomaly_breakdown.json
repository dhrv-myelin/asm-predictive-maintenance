          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "WITH selected_cycle AS (\n  SELECT\n    cycle_count,\n    DATE(timestamp) AS cycle_date\n  FROM process_metrics\n  WHERE station_name = 'rbw_station'\n  ORDER BY ABS(EXTRACT(EPOCH FROM (\n    timestamp - CAST(NULLIF('${anomaly_time}', '') AS timestamptz)\n  )))\n  LIMIT 1\n),\n\nmetrics AS (\n  SELECT DISTINCT metric_name\n  FROM process_metrics\n  WHERE station_name = 'rbw_station'\n    AND unit = 'duration_seconds'\n),\n\nbase AS (\n  SELECT\n    m.metric_name,\n    MAX(p.timestamp) AS timestamp,\n    SUM(p.value) AS value\n  FROM metrics m\n  CROSS JOIN selected_cycle sc\n  LEFT JOIN process_metrics p\n    ON p.metric_name = m.metric_name\n    AND p.cycle_count = sc.cycle_count\n    AND DATE(p.timestamp) = sc.cycle_date   -- 👈 NEW\n    AND p.station_name = 'rbw_station'\n    AND p.unit = 'duration_seconds'\n  GROUP BY m.metric_name\n),\n\nbaseline AS (\n  SELECT\n    metric_name,\n    (mean + 3 * std_dev) AS ucl\n  FROM baseline_metrics\n  WHERE station_name = 'rbw_station'\n)\n\nSELECT\n  COALESCE(b.timestamp, CAST('${anomaly_time}' AS timestamptz)) AS time,\n  b.metric_name,\n  COALESCE(b.value, 0) AS value,\n  bl.ucl,\n\n  CASE\n    WHEN COALESCE(b.value, 0) > bl.ucl THEN 'Anomaly'\n    ELSE 'Normal'\n  END AS status\n\nFROM base b\nLEFT JOIN baseline bl\n  ON b.metric_name = bl.metric_name\n\nORDER BY status DESC, b.metric_name;",
          "refId": "A",
          "sql": {
