          "editorMode": "code",
          "format": "table",
          "hide": true,
          "rawQuery": true,
          "rawSql": "WITH selected_cycle AS (\n  SELECT\n    s.timestamp AS start_time,\n    (\n      SELECT MIN(e.timestamp)\n      FROM process_metrics e\n      WHERE e.station_name = 'ced_station'\n        AND e.metric_name = 'exit_stopper_raising_time'\n        AND e.timestamp > s.timestamp\n    ) AS end_time\n  FROM process_metrics s\n  WHERE s.station_name = 'ced_station'\n    AND s.metric_name = 'upstream_waiting_time'\n    AND s.timestamp <= CAST(NULLIF('${anomaly_time}', '') AS timestamptz)\n   ORDER BY s.timestamp DESC\n  LIMIT 1\n)\n\nSELECT DISTINCT ON (p.timestamp, p.metric_name)\n  p.timestamp AS time,\n  p.metric_name,\n  p.value\nFROM process_metrics p\nJOIN selected_cycle c\n  ON p.timestamp BETWEEN c.start_time AND c.end_time\nWHERE p.station_name = 'ced_station'\nORDER BY p.timestamp, p.metric_name;",
          "refId": "A",
          "sql": {
