      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bffvbhhjc42yoe"
          },
          "editorMode": "code",
          "format": "table",
          "hide": true,
          "rawQuery": true,
          "rawSql": "SELECT\n    mp.actual_timestamp                             AS \"Detected At\",\n    mp.metric_name                                  AS \"Metric\",\n    SPLIT_PART(mp.model_name, '::', 2)              AS \"Pattern\",\n    COALESCE(sp.type_of_motor::text, 'N/A')                        AS \"Type\",\n    COALESCE(sp.likely_causes_and_what_to_inspect::text, 'N/A')    AS \"Likely Causes and Maintenance Suggestions\",\n    -- COUNT(*) OVER (\n    --     PARTITION BY mp.metric_name, SPLIT_PART(mp.model_name, '::', 2)\n    -- )                                               AS \"Occurrences\",\n    CASE SPLIT_PART(mp.model_name, '::', 2)\n    WHEN 'Trend acceleration'   THEN 'Hours – < 1 day'\n    WHEN 'Step jumps'           THEN '1 – 3 days'\n    WHEN 'Random spikes'        THEN '3 – 14 days'\n    -- WHEN 'Slow drift'           THEN '2 – 6 weeks'\n    -- WHEN 'Baseline shift'       THEN '3 – 14 days'\n    WHEN 'Periodic oscillation' THEN '3 – 14 days'\n    WHEN 'Variance Growth'      THEN '3 – 14 days'\n    ELSE                             'Unknown'\nEND                                             AS \"Recommended Time for Action\"\n\nFROM model_predictions mp\nINNER JOIN statistical_patterns sp\n    ON LOWER(SPLIT_PART(mp.model_name, '::', 2)) = LOWER(sp.statistical_pattern)\n    AND mp.metric_name = sp.metric_name\n\nWHERE\n    mp.actual_timestamp >= $__timeFrom()\n    AND mp.actual_timestamp < $__timeTo()\n    AND mp.model_name LIKE 'stats_pattern_detector::%'   -- ← added filter\n\nORDER BY\n    CASE SPLIT_PART(mp.model_name, '::', 2)\n        WHEN 'Trend acceleration' THEN 1\n        WHEN 'Step jumps'         THEN 1\n        WHEN 'Random spikes'      THEN 2\n        WHEN 'Slow drift'         THEN 2\n        WHEN 'Baseline shift'     THEN 2\n        ELSE 3\n    END,\n    mp.actual_timestamp DESC;",
          "refId": "B",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bffvbhhjc42yoe"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\n    mp.actual_timestamp                             AS \"Detected At\",\n    mp.metric_name                                  AS \"Metric\",\n    SPLIT_PART(mp.model_name, '::', 2)              AS \"Pattern\",\n    COALESCE(sp.type_of_motor::text, 'N/A')         AS \"Type\",\n    COALESCE(sp.likely_causes_and_what_to_inspect::text, 'N/A') AS \"Likely Causes and Maintenance Suggestions\",\n\n    -- 🔥 NEW SEVERITY COLUMN\n    CASE SPLIT_PART(mp.model_name, '::', 2)\n        WHEN 'Trend acceleration'   THEN 10\n        WHEN 'Step Jump'           THEN 10\n        WHEN 'Random Spikes'        THEN 3\n        WHEN 'Slow Drift'           THEN 8\n        WHEN 'Baseline Shift'       THEN 8\n        WHEN 'Periodic Oscillation' THEN 8\n        WHEN 'Variance growth'      THEN 8\n        ELSE 3\n    END AS \"Severity (Based on Impact)\",\n\n    CASE SPLIT_PART(mp.model_name, '::', 2)\n        WHEN 'Trend acceleration'   THEN 'Hours – < 1 day'\n        WHEN 'Step Jump'           THEN '1 – 3 days'\n        WHEN 'Random Spikes'        THEN '3 – 14 days'\n        WHEN 'Slow Drift'           THEN '2 – 6 weeks'\n        WHEN 'Baseline Shift'       THEN '3 – 14 days'\n        WHEN 'Periodic Oscillation' THEN '3 – 14 days'\n        WHEN 'Variance Growth'      THEN '3 – 14 days'\n        ELSE 'Unknown'\n    END AS \"Recommended Time for Action (Based on expected time to failure)\"\n\nFROM model_predictions mp\nINNER JOIN statistical_patterns sp\n    ON LOWER(SPLIT_PART(mp.model_name, '::', 2)) = LOWER(sp.statistical_pattern)\n    AND mp.metric_name = sp.metric_name\n\nWHERE\n    mp.actual_timestamp >= $__timeFrom()\n    AND mp.actual_timestamp < $__timeTo()\n    AND mp.model_name LIKE 'stats_pattern_detector::%'\n    AND SPLIT_PART(mp.model_name, '::', 2) NOT IN ('Slow Drift', 'Periodic Oscillation')\n\nORDER BY\n    CASE SPLIT_PART(mp.model_name, '::', 2)\n        WHEN 'Trend acceleration' THEN 1\n        WHEN 'Step jumps'         THEN 1\n        WHEN 'Random spikes'      THEN 2\n        WHEN 'Slow drift'         THEN 2\n        WHEN 'Baseline shift'     THEN 2\n        ELSE 3\n    END,\n    mp.actual_timestamp DESC;",
          "refId": "A",
          "sql": {
