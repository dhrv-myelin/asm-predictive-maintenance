      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bffvbhhjc42yoe"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH selected_cycle AS (\n  SELECT cycle_count\n  FROM process_metrics\n  WHERE station_name = 'ced_station'\n    AND metric_name = 'cavity_2_dispensing_time'\n  ORDER BY ABS(EXTRACT(EPOCH FROM (\n    timestamp - '${anomaly_time}'::timestamptz\n  )))\n  LIMIT 1\n),\n\nmetric_values AS (\n  SELECT\n    metric_name,\n    MAX(value) AS value\n  FROM process_metrics\n  WHERE station_name = 'ced_station'\n    AND cycle_count = (SELECT cycle_count FROM selected_cycle)\n    AND metric_name IN (\n      'cavity_1_dispensing_time',\n      'cavity_2_dispensing_time',\n      'cavity_3_dispensing_time',\n      'cavity_4_dispensing_time',\n      'cavity_5_dispensing_time',\n      'cavity_6_dispensing_time',\n      'pre_cavity_2_dispensing_delay',\n      'pre_cavity_3_dispensing_delay',\n      'pre_cavity_4_dispensing_delay',\n      'pre_cavity_5_dispensing_delay',\n      'pre_cavity_6_dispensing_delay'\n    )\n  GROUP BY metric_name\n),\n\nbaselines AS (\n  SELECT\n    metric_name,\n    AVG(value)         AS mean,\n    STDDEV_SAMP(value) AS std\n  FROM process_metrics\n  WHERE station_name = 'ced_station'\n    AND metric_name IN (\n      'cavity_1_dispensing_time',\n      'cavity_2_dispensing_time',\n      'cavity_3_dispensing_time',\n      'cavity_4_dispensing_time',\n      'cavity_5_dispensing_time',\n      'cavity_6_dispensing_time',\n      'pre_cavity_2_dispensing_delay',\n      'pre_cavity_3_dispensing_delay',\n      'pre_cavity_4_dispensing_delay',\n      'pre_cavity_5_dispensing_delay',\n      'pre_cavity_6_dispensing_delay'\n    )\n  GROUP BY metric_name\n)\n\nSELECT\n  mv.metric_name                          AS \"Metric\",\n  ROUND(mv.value::numeric, 3)             AS \"Value (s)\",\n  ROUND(b.mean::numeric, 3)               AS \"Mean\",\n  ROUND((b.mean + 3 * b.std)::numeric, 3) AS \"UCL\",\n  ROUND((b.mean - 3 * b.std)::numeric, 3) AS \"LCL\",\n  CASE\n    WHEN mv.value > (b.mean + 3 * b.std)\n      OR mv.value < (b.mean - 3 * b.std)\n    THEN 'ANOMALY'\n    ELSE 'Normal'\n  END AS \"Status\"\nFROM metric_values mv\nJOIN baselines b USING (metric_name)\nORDER BY mv.metric_name;",
          "refId": "A",
          "sql": {
