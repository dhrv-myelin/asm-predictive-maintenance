          "rawSql": "SELECT gs AS time, 'Warning (+1.5σ)' AS metric, 1.5::float AS zscore\nFROM generate_series($__timeFrom()::timestamptz, $__timeTo()::timestamptz,\n  ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)) AS gs",
