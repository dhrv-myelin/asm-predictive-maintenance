          "datasource": {
            "type": "postgres",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  predicted_timestamp AS time,\n  AVG(predicted_value) OVER (\n    ORDER BY predicted_timestamp\n    RANGE BETWEEN INTERVAL '${sma_window}' PRECEDING AND CURRENT ROW\n  ) AS health_trend_sma\nFROM model_predictions\nWHERE station_name = 'ced_machine'\n  AND metric_name  = 'health_score'\n  AND $__timeFilter(predicted_timestamp)\nORDER BY predicted_timestamp",
