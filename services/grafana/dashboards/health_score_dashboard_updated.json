      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH stats AS (\n  SELECT\n    metric_name,\n    AVG(value)    AS mu,\n    STDDEV(value) AS sigma\n  FROM process_metrics\n  WHERE station_name = 'ced_station'\n    AND metric_name != 'count'\n    AND $__timeFilter(timestamp)\n  GROUP BY metric_name\n  HAVING STDDEV(value) > 0\n),\nranked AS (\n  SELECT\n    t.metric_name,\n    MAX(ABS((t.value - s.mu) / s.sigma)) AS max_abs_zscore\n  FROM process_metrics t\n  JOIN stats s USING (metric_name)\n  WHERE t.station_name = 'ced_station'\n    AND t.metric_name != 'count'\n    AND $__timeFilter(t.timestamp)\n  GROUP BY t.metric_name\n  ORDER BY max_abs_zscore DESC\n  LIMIT 3\n),\nzscores AS (\n  SELECT\n    t.timestamp AS time,\n    t.metric_name AS metric,\n    (t.value - s.mu) / s.sigma AS zscore\n  FROM process_metrics t\n  JOIN stats s USING (metric_name)\n  JOIN ranked r USING (metric_name)\n  WHERE t.station_name = 'ced_station'\n    AND $__timeFilter(t.timestamp)\n)\nSELECT time, metric, zscore\nFROM zscores\nORDER BY time",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
