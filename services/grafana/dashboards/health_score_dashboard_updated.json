          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  predicted_timestamp AS time,\n  predicted_value     AS health_score\nFROM model_predictions\nWHERE station_name = 'ced_machine'\n  AND metric_name  = 'health_score'\n  AND $__timeFilter(predicted_timestamp)\nORDER BY predicted_timestamp",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
