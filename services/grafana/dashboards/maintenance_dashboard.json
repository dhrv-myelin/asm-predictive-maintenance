            "editorMode": "code",
            "format": "table",
            "hide": false,
            "rawQuery": true,
            "rawSql": "WITH normalized_patterns AS (\n    SELECT\n        id,\n        statistical_pattern,\n        likely_causes_and_what_to_inspect,\n        type_of_motor,\n        TRIM(UNNEST(STRING_TO_ARRAY(station_metrics, ','))) AS metric_name\n    FROM statistical_patterns\n)\nSELECT\n    statistical_pattern,\n    likely_causes_and_what_to_inspect,\n    type_of_motor,\n    BOOL_OR(metric_name = 'entry_stopper_lowering_time')      AS entry_stopper_lowering_time,\n    BOOL_OR(metric_name = 'movein_to_entry_stopper_up_delay') AS movein_to_entry_stopper_up_delay,\n    BOOL_OR(metric_name = 'entry_stopper_raising_time')       AS entry_stopper_raising_time,\n    BOOL_OR(metric_name = 'pallet_clamping_time')             AS pallet_clamping_time,\n    BOOL_OR(metric_name = 'pallet_lifting_time')              AS pallet_lifting_time,\n    BOOL_OR(metric_name = 'pallet_unclamping_time')           AS pallet_unclamping_time,\n    BOOL_OR(metric_name = 'pallet_lowering_time')             AS pallet_lowering_time,\n    BOOL_OR(metric_name = 'downstream_waiting_time')          AS downstream_waiting_time,\n    BOOL_OR(metric_name = 'pallet_moveout_time')              AS pallet_moveout_time,\n    BOOL_OR(metric_name = 'pallet_movein_time')               AS pallet_movein_time,\n    BOOL_OR(metric_name = 'exit_stopper_lowering_time')       AS exit_stopper_lowering_time,\n    BOOL_OR(metric_name = 'dispensing_time')                  AS dispensing_time,\n    BOOL_OR(metric_name = 'inspection_time')                  AS inspection_time\nFROM normalized_patterns\nGROUP BY statistical_pattern, likely_causes_and_what_to_inspect, type_of_motor\nORDER BY type_of_motor, statistical_pattern;",
            "refId": "B",
            "sql": {
