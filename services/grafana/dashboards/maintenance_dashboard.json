      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bffvbhhjc42yoe"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\n    mp.actual_timestamp                             AS \"Detected At\",\n    mp.metric_name                                  AS \"Metric\",\n    SPLIT_PART(mp.model_name, '::', 2)              AS \"Pattern\",\n    sp.type_of_motor                                AS \"Type\",\n    sp.likely_causes_and_what_to_inspect            AS \"Likely Causes and Maintenance Suggestions\",\n    COUNT(*) OVER (\n        PARTITION BY mp.metric_name, SPLIT_PART(mp.model_name, '::', 2)\n    )                                               AS \"Occurrences\",\n    CASE SPLIT_PART(mp.model_name, '::', 2)\n        WHEN 'Trend acceleration'  THEN '🔴 High'\n        WHEN 'Step jumps'          THEN '🔴 High'\n        WHEN 'Random spikes'       THEN '🟡 Medium'\n        WHEN 'Slow drift'          THEN '🟡 Medium'\n        WHEN 'Baseline shift'      THEN '🟡 Medium'\n        WHEN 'Periodic oscillation'THEN '🟢 Low'\n        WHEN 'Recovery cycles'     THEN '🟢 Low'\n        ELSE '🟢 Low'\n    END                                             AS \"Severity\"\nFROM model_predictions mp\nINNER JOIN statistical_patterns sp\n    ON LOWER(SPLIT_PART(mp.model_name, '::', 2)) = LOWER(sp.statistical_pattern)\n    AND mp.metric_name = sp.metric_name\nORDER BY\n    CASE SPLIT_PART(mp.model_name, '::', 2)\n        WHEN 'Trend acceleration' THEN 1\n        WHEN 'Step jumps'         THEN 1\n        WHEN 'Random spikes'      THEN 2\n        WHEN 'Slow drift'         THEN 2\n        WHEN 'Baseline shift'     THEN 2\n        ELSE 3\n    END,\n    mp.actual_timestamp DESC;",
          "refId": "B",
          "sql": {
